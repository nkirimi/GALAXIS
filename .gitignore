# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/
out/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json
# Generated by CMake. We never write our own Makefile.
Makefile

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Editor and IDE settings
.vscode/
.idea/
.vs/
*.user

# Generated images
# Ignore images the program produces while testing...
*.ppm
*.bmp
# ...but keep the sample outputs we choose to save in docs/
# (these exceptions must stay below the rules above)
!docs/*.ppm
!docs/*.bmp
!docs/*.png
